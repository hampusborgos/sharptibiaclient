<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CTC</RootNamespace>
    <AssemblyName>CTC</AssemblyName>
    <Platforms>AnyCPU</Platforms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- Properties/AssemblyInfo.cs still carries the XNA-era attributes; without this
         they collide with the SDK's generated ones (CS0579). -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- This is a 2010 codebase; don't fail the build on its many benign warnings. -->
    <NoWarn>$(NoWarn);CS0168;CS0169;CS0414;CS0649;CS0219</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5.1" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.5.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- LogicalName is load-bearing: TibiaGameProtocol.cs looks this resource up by
         the exact string "CTC.TibiaProtocolMap.xml". -->
    <EmbeddedResource Include="TibiaProtocolMap.xml" LogicalName="CTC.TibiaProtocolMap.xml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tibia.dat / Tibia.spr, extracted from original/installers via innoextract. -->
    <None Include="Data\**" CopyToOutputDirectory="PreserveNewest" LinkBase="Data" />
    <None Include="..\recordings\*.tmv" CopyToOutputDirectory="PreserveNewest" LinkBase="recordings" />
  </ItemGroup>

</Project>
